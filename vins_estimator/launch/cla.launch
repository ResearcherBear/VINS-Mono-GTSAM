<launch>

    <arg name="config_path" default = "$(find-pkg-share feature_tracker)/../config/cla/cla_config.yaml" />
    <arg name="vins_path" default = "$(find-pkg-share feature_tracker)/../config/../" />

    <node name="feature_tracker" pkg="feature_tracker" exec="feature_tracker_node" output="log">
        <param name="config_file" type="str" value="$(var config_path)" />
        <param name="vins_folder" type="str" value="$(var vins_path)" />
    </node>

    <node name="vins_estimator" pkg="vins_estimator" exec="vins_estimator_node" output="screen">
        <param name="config_file" type="str" value="$(var config_path)" />
        <param name="vins_folder" type="str" value="$(var vins_path)" />
    </node>

    <node name="pose_graph" pkg="pose_graph" exec="pose_graph_node" output="screen">
        <param name="config_file" type="str" value="$(var config_path)" />
        <param name="visualization_shift_x" type="int" value="0" />
        <param name="visualization_shift_y" type="int" value="0" />
        <param name="skip_cnt" type="int" value="0" />
        <param name="skip_dis" type="float" value="0.1" />
    </node>

</launch>